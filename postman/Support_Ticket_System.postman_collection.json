          ]
        },
        {
          "name": "Update Ticket Status & Assign Agent",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"URGENT\",\n  \"assigned_to\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{createdTicketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{createdTicketId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Ticket status is IN_PROGRESS\", function () {",
                  "    pm.expect(jsonData.ticket.status).to.eql(\"IN_PROGRESS\");",
                  "    pm.expect(jsonData.ticket.assigned_to).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Agent Response Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
